<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme"
            android:textColor="@color/title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/groupTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_system"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_light"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_dark"
                android:textColor="@color/ink" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_language"
            android:textColor="@color/title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/groupLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/langSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_system"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/langEs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_es"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/langEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_en"
                android:textColor="@color/ink" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
